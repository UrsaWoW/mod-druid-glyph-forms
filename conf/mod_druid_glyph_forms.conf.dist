########################################
# GlyphForms module configuration
########################################
#
#    GlyphForms.Enable
#        Description: Repurposes Glyph of Unburdened Rebirth: instead of
#                      waiving Rebirth's reagent requirement, Tauren and Night
#                      Elf druids who have the glyph slotted use the classic
#                      (pre-WotLK) Bear Form, Dire Bear Form, and Cat Form
#                      models instead of the WotLK per-hair/skin-color ones.
#        Default:     1 - (Enabled)
#                     0 - (Disabled, restores core's default Glyph of
#                          Unburdened Rebirth: real Rebirth reagent waiver,
#                          no form model changes)
#

GlyphForms.Enable = 1
